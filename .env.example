# Telegram (required for polling and optional workflow notifications)
TELEGRAM_TOKEN=
CHAT_ID=

# OpenRouter (required for AI answers, code assistance, summaries, and evolution)
OPENROUTER_API_KEY=

# Optional read-only IMAP access
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993

# Optional research API key
SEMANTIC_SCHOLAR_API_KEY=

# Runtime modes: poll, command, once, selftest
AGENT_MODE=poll
# Used only by AGENT_MODE=command
TASK=help

# Authorization: dangerous tools pause for explicit /approve TASK-ID in Telegram.
# Set full-auto only when you intentionally want unattended side effects.
AGENT_APPROVAL_MODE=dangerous

# Durable agent context and memory
AGENT_CONTEXT_FILE=context_state.json
AGENT_MEMORY_DB_FILE=memory.sqlite3
AGENT_MAX_STEPS=20
AGENT_MAX_REPLANS=3
AGENT_MAX_RETRIES=2
AGENT_MAX_WORKERS=2
