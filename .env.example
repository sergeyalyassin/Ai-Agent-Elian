# Telegram (required for polling and optional workflow notifications)
TELEGRAM_TOKEN=
CHAT_ID=

# OpenRouter (required for AI answers, code assistance, summaries, and evolution)
OPENROUTER_API_KEY=

# Optional read-only IMAP access
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993

# Optional research API key
SEMANTIC_SCHOLAR_API_KEY=

# Runtime modes: poll, command, once, selftest
AGENT_MODE=poll
# Used only by AGENT_MODE=command
TASK=help
